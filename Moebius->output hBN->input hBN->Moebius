import numpy as np
import matplotlib.pyplot as plt

def simulate_moebius_hbn_energy():
    # 1. 파라미터 설정
    t = np.linspace(0, 20, 1000)  # 시간 (순환 횟수 대용)
    dt = t[1] - t[0]
    
    # 물리적 변수
    omega_r = 1.0        # 공진기 모드 주파수
    g = 0.15             # hBN과의 강결합 계수 (Strong Coupling)
    tunnel_eff = 0.998   # 터널링 효율 (간극이 매우 적음)
    
    # 에너지 및 필드 초기화
    E_cavity = np.zeros(len(t)) # 공진기 내 필드 에너지
    E_hbn = np.zeros(len(t))    # hBN 폴라리톤 결합 에너지
    E_total = np.zeros(len(t))  # 전체 시스템 에너지
    
    E_cavity[0] = 1.0    # 초기 입력 에너지
    
    # 2. 루프 시뮬레이션 (뫼비우스 통과 및 재입력 로직)
    for i in range(1, len(t)):
        # 뫼비우스 구조를 통한 위상 변화 및 강결합 에너지 교환
        # 강결합에 의한 가역적 에너지 교환 (Hamiltonian 상호작용 모사)
        exchange = g * np.sin(omega_r * t[i]) * E_cavity[i-1]
        
        # 터널링에 의한 재입력 손실 반영
        E_cavity[i] = (E_cavity[i-1] - exchange) * tunnel_eff
        E_hbn[i] = (E_hbn[i-1] + exchange) * tunnel_eff
        
        # 전체 에너지 보존 확인
        E_total[i] = E_cavity[i] + E_hbn[i]

    # 3. 결과 시각화
    plt.figure(figsize=(10, 5), dpi=100)
    plt.plot(t, E_total, label='Total System Energy', color='#1f77b4', linewidth=2)
    plt.plot(t, E_cavity, label='Cavity Mode Energy', color='#ff7f0e', alpha=0.6, linestyle='--')
    plt.axhline(y=1.0, color='red', linestyle=':', label='Theoretical Limit (1.0)')
    
    plt.title("Energy Stability in Moebius-hBN Tunneling Structure")
    plt.xlabel("Interaction Cycles (Time)")
    plt.ylabel("Normalized Energy")
    plt.ylim(0.9, 1.1) # 보존 여부를 보기 위해 범위를 좁게 설정
    plt.grid(True, which='both', linestyle='--', alpha=0.5)
    plt.legend(loc='upper right')
    plt.tight_layout()
    plt.show()

# 실행
simulate_moebius_hbn_energy()
